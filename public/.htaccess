# public/.htaccess – production version for www.interwindows.pl (Apache / LiteSpeed).
# Do not upload to a preview host. Rules: docs/seo-plan.md §5.1 + caching from the Profil project.

RewriteEngine On

# 1) one canonical host: https + www in a single redirect
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.interwindows\.pl$ [NC]
RewriteRule ^ https://www.interwindows.pl%{REQUEST_URI} [L,R=301]

# 2) /index.html and /folder/index.html -> address with a trailing slash (external requests only)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NC]

# 3) old one-page contact form endpoint
RewriteRule ^assets/phpscripts/contact\.php$ /kontakt/ [L,R=301,NC]

# 4) assets of the old site are gone for good (the new build uses /_astro/ and /img/ – never create public/assets/)
RewriteRule ^assets/ - [G,NC]

# folders without a trailing slash: Apache/LiteSpeed redirect /okna -> /okna/ themselves (DirectorySlash On)

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_headers.c>
  # enable after checking that https works on both hosts
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>
