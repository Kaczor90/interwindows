---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/oferta';
---

<Base title="Nie znaleziono strony | Inter Windows" description="Ta strona nie istnieje lub zmieniła adres." noindex>
  <section class="page-hero">
    <div class="container" style="padding-block:clamp(32px,7vw,96px) 0">
      <span class="eyebrow">Błąd 404</span>
      <h1>Tej strony tu nie ma</h1>
      <p class="lead" style="max-width:600px">
        Strona mogła zmienić adres po odświeżeniu serwisu. Zajrzyj do oferty poniżej albo po prostu zadzwoń – chętnie pomożemy.
      </p>
      <div class="btn-row" style="margin-top:32px">
        <a class="btn" href={url('/')}><Icon name="arrow" class="arrow" /> Strona główna</a>
        <a class="btn btn--ghost" href={url('/kontakt/')}>Kontakt</a>
      </div>
    </div>
  </section>
  <section class="section section--tight pt-0">
    <div class="container">
      <div class="related">
        {categories.map((c) => <a href={url(`/${c.slug}/`)}><Icon name={c.slug} class="icon" />{c.title}</a>)}
        <a href={url('/montaz-okien/')}><Icon name="montaz" class="icon" />Montaż okien</a>
        <a href={url('/realizacje/')}><Icon name="dom" class="icon" />Realizacje</a>
      </div>
    </div>
  </section>
</Base>
