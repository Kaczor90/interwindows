---
// Guide article (/poradnik/<slug>/) generated from src/data/poradnik.ts.
// JSON-LD: BlogPosting (author = the organisation, as agreed for launch) + BreadcrumbList (Breadcrumbs).
import { url } from '../../lib/url';
import { rich } from '../../lib/rich';
import { srcsetOf } from '../../lib/img';
import { article as articleSchema, abs } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { aiImage, aiSrc, aiSrcSmall } from '../../data/ai-zdjecia';
import { photoByFile, photoSrc, photoSrcSmall } from '../../data/realizacje-zdjecia';
import { site } from '../../data/site';
import { articles, readingTime, formatDate, wordCount, nbDash, type Article, type Block } from '../../data/poradnik';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Article };
const path = `/poradnik/${a.slug}/`;
const img = aiImage(a.image);
const minutes = readingTime(a);
const others = articles.filter((x) => x.slug !== a.slug).map((x) => ({ ...x, img: aiImage(x.image), minutes: readingTime(x) }));
const TBC = 'Treść czeka na potwierdzenie przez Inter Windows';

const schema = {
  ...articleSchema({
    headline: a.h1,
    path,
    image: aiSrc(img),
    datePublished: a.published,
    dateModified: a.updated,
    description: a.seo.description,
    // signed by the company until a named author is agreed (docs/do-uzupelnienia.md)
    author: 'organization',
  }),
  articleSection: a.tag,
  wordCount: wordCount(a),
  isPartOf: { '@type': 'Blog', name: 'Poradnik Inter Windows', url: abs('/poradnik/') },
};

const kind = (b: Block) =>
  typeof b === 'string' ? 'p' : 'h3' in b ? 'h3' : 'ul' in b ? 'ul' : 'ol' in b ? 'ol' : 'table' in b ? 'table' : 'photo' in b ? 'photo' : 'note';
const photoOf = (file: string) => {
  const p = photoByFile(file);
  if (!p) throw new Error(`Brak zdjęcia realizacji: ${file}`);
  return p;
};
---

<Base title={a.seo.title} description={a.seo.description} updated={a.updated} ogType="article" schema={schema}>
  <article class="post">
    <header class="post-head">
      <div class="container">
        <Breadcrumbs items={[{ name: 'Poradnik', path: '/poradnik/' }, { name: a.h1 }]} />
        <div class="post-head__text">
          <div class="post-meta">
            <span class="card__tag">{a.tag}</span>
            <span>{minutes} min czytania</span>
          </div>
          <h1>{nbDash(a.h1)}</h1>
          <p class="lead">{a.lead}</p>
          <p class="post-byline">
            <span>Autor: <a href={url('/o-firmie/')}>{site.name}</a></span>
            <span>Opublikowano <time datetime={a.published}>{formatDate(a.published)}</time></span>
            {a.updated !== a.published && <span>Aktualizacja <time datetime={a.updated}>{formatDate(a.updated)}</time></span>}
          </p>
        </div>
      </div>
      <div class="container">
        <figure class="photo post-cover">
          <img
            src={url(aiSrc(img))}
            srcset={srcsetOf(aiSrc(img), img.width, img.height, aiSrcSmall(img))}
            sizes="(min-width: 1300px) 1240px, 100vw"
            alt={img.alt}
            width={img.width}
            height={img.height}
            fetchpriority="high"
          />
        </figure>
      </div>
    </header>

    <div class="container post-grid">
      <aside class="post-aside">
        <nav class="post-toc" aria-label="Spis treści">
          <span class="post-aside__label">W artykule</span>
          <ol>
            {a.sections.map((s) => <li><a href={`#${s.id}`}>{s.h2}</a></li>)}
          </ol>
        </nav>
        <div class="post-links">
          <span class="post-aside__label">Strony z ofertą</span>
          {a.links.map((l) => <a href={url(l.href)}><Icon name={l.icon} class="icon" />{l.label}</a>)}
        </div>
      </aside>

      <div class="prose post-body">
        {a.sections.map((s) => (
          <section id={s.id}>
            <h2>{s.h2}</h2>
            {s.blocks.map((b) => {
              const k = kind(b);
              if (k === 'p') return <p set:html={rich(b as string)} />;
              if (k === 'h3') return <h3>{(b as { h3: string }).h3}</h3>;
              if (k === 'ul') return <ul>{(b as { ul: string[] }).ul.map((li) => <li set:html={rich(li)} />)}</ul>;
              if (k === 'ol') return <ol>{(b as { ol: string[] }).ol.map((li) => <li set:html={rich(li)} />)}</ol>;
              if (k === 'table') {
                const t = (b as { table: { caption?: string; head: string[]; rows: string[][] } }).table;
                return (
                  <div class="table-wrap">
                    <table>
                      {t.caption && <caption>{t.caption}</caption>}
                      <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                      <tbody>{t.rows.map((r) => <tr>{r.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
                    </table>
                  </div>
                );
              }
              if (k === 'photo') {
                const ph = b as { photo: string; caption: string };
                const p = photoOf(ph.photo);
                return (
                  <figure class="post-photo">
                    <div class="photo">
                      <img
                        src={url(photoSrcSmall(p))}
                        srcset={srcsetOf(photoSrc(p), p.width, p.height, photoSrcSmall(p))}
                        sizes="(min-width: 960px) 720px, 100vw"
                        alt={p.alt}
                        width={p.width}
                        height={p.height}
                        loading="lazy"
                      />
                    </div>
                    <figcaption>{ph.caption}</figcaption>
                  </figure>
                );
              }
              const n = b as { note: string; title?: string; tbc?: boolean };
              return (
                <aside class:list={['post-note', { 'post-note--tbc': n.tbc }]}>
                  {n.title && <strong>{n.title}{n.tbc && <> <span class="tbc" title={TBC}>do uzupełnienia</span></>}</strong>}
                  <p set:html={rich(n.note)} />
                </aside>
              );
            })}
          </section>
        ))}

        <div class="post-author">
          <Icon name="partner" class="icon" />
          <div>
            <strong>{site.name}</strong>
            <p>
              Doradzamy, mierzymy i montujemy okna, drzwi, rolety i bramy w Płocku i okolicach. Montaż wykonuje wyłącznie nasza ekipa.{' '}
              <a href={url('/o-firmie/')}>Poznaj nas</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <CtaBand
    title={a.cta.title}
    text={a.cta.text}
    primary={a.cta.primary}
    secondary={a.cta.secondary}
  />

  <section class="section section--tight pt-0">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <h2>Czytaj dalej</h2>
        </div>
        <a class="link-arrow" href={url('/poradnik/')}>Wszystkie artykuły <Icon name="arrow" class="" /></a>
      </div>
      <ul class="more" role="list">
        {others.map((o) => (
          <li>
            <a href={url(`/poradnik/${o.slug}/`)}>
              <div class="photo more__img">
                <img src={url(aiSrcSmall(o.img))} alt={o.img.alt} width={o.img.width} height={o.img.height} loading="lazy" />
              </div>
              <span class="card__tag">{o.tag} · {o.minutes} min</span>
              <strong>{nbDash(o.h1)}</strong>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .post-head { padding-top: clamp(28px, 4vw, 48px); }
  .post-head__text { max-width: 860px; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: .82rem; color: var(--muted); margin-bottom: 18px; }
  .post-head h1 { font-size: clamp(2.2rem, 4.2vw, 3.6rem); margin-bottom: 22px; }
  .post-head .lead { max-width: 760px; }
  .post-byline { display: flex; flex-wrap: wrap; gap: 6px 24px; margin: 22px 0 0; font-size: .84rem; color: var(--muted); }
  .post-cover { aspect-ratio: 16 / 7; margin: clamp(32px, 4vw, 48px) 0 0; }
  @media (max-width: 700px) { .post-cover { aspect-ratio: 16 / 10; } }

  .post-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; padding-block: clamp(48px, 6vw, 88px); }
  @media (min-width: 1000px) {
    .post-grid { grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); gap: 64px; align-items: start; }
    .post-aside { position: sticky; top: calc(var(--header-h) + 28px); }
  }
  .post-aside { display: grid; gap: 28px; }
  .post-aside__label { display: block; margin-bottom: 12px; font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .post-toc ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); counter-reset: toc; }
  .post-toc li { counter-increment: toc; border-bottom: 1px solid var(--line); }
  .post-toc a { display: grid; grid-template-columns: 28px 1fr; padding: 10px 0; font-size: .88rem; line-height: 1.4; color: var(--ink); }
  .post-toc a::before { content: counter(toc, decimal-leading-zero); font-size: .72rem; font-weight: 600; color: var(--accent); padding-top: 2px; }
  .post-toc a:hover { color: var(--navy); }
  .post-links { display: grid; }
  .post-links a { display: flex; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: .9rem; font-weight: 500; color: var(--ink); }
  .post-links a:hover { color: var(--navy); }
  .post-links :global(.icon) { width: 28px; height: 28px; flex: none; }
  @media (max-width: 999px) {
    .post-aside { padding: 22px; background: var(--bg-softer); border: 1px solid var(--line); }
  }

  .post-body { max-width: 740px; }
  .post-body section { scroll-margin-top: calc(var(--header-h) + 16px); }
  .post-body section:first-child h2 { margin-top: 0; }
  .post-body .table-wrap { margin: 18px 0 28px; }
  .post-body .table-wrap table { min-width: 520px; }
  .post-photo { margin: 24px 0 28px; }
  .post-photo .photo { aspect-ratio: 4 / 3; }
  .post-photo figcaption { margin-top: 10px; font-size: .84rem; color: var(--muted); line-height: 1.5; }
  .post-note { margin: 22px 0 26px; padding: 18px 22px; background: var(--bg-softer); border-left: 2px solid var(--accent); }
  .post-note strong { display: block; margin-bottom: 6px; }
  .post-note p { margin: 0; color: var(--muted); font-size: .92rem; }
  .post-note--tbc { border: 1px dashed var(--accent-line); border-left-width: 2px; }
  .post-note .tbc { margin-left: 6px; }

  .post-author {
    display: grid; grid-template-columns: 44px 1fr; gap: 18px;
    margin-top: 48px; padding: 24px;
    border: 1px solid var(--line); background: #fff;
  }
  .post-author :global(.icon) { width: 40px; height: 40px; }
  .post-author p { margin: 4px 0 0; font-size: .9rem; color: var(--muted); }

  .more { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  @media (min-width: 760px) { .more { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .more a { display: grid; gap: 10px; align-content: start; }
  .more__img { aspect-ratio: 16 / 10; margin-bottom: 6px; }
  .more strong { font-weight: 500; font-size: 1.12rem; line-height: 1.3; letter-spacing: -0.02em; color: var(--ink); }
  .more a:hover strong { color: var(--navy); }
</style>
