---
import { url } from '../lib/url';
import { webPage } from '../lib/schema';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import MapLink from '../components/MapLink.astro';
import { site, people, social } from '../data/site';

// Google Business Profile link (stable CID) – used for the map panel and 'Wyznacz trasę'
const mapsUrl = site.googleMapsUrl;
const roles: Record<string, string> = { 'Paweł Majchrzak': 'Współwłaściciel', 'Bartosz Bezdziek': 'Współwłaściciel' };
---

<Base
  title="Kontakt – Płock, ul. Przemysłowa 22 | Inter Windows"
  description="Inter Windows, ul. Przemysłowa 22, 09-400 Płock, tel. 697 886 093. Umów bezpłatny pomiar lub spotkanie z doradcą w biurze sprzedaży."
  updated="2026-10-27"
  schema={webPage('ContactPage', '/kontakt/', 'Kontakt – Inter Windows')}
  footerCta={false}
>
  <PageHero
    title="Kontakt i bezpłatny pomiar"
    lead="Zadzwoń, napisz albo wyślij formularz. Oddzwonimy, umówimy pomiar u Ciebie i przygotujemy wycenę. Pomiar i wycena są bezpłatne i niezobowiązujące."
    breadcrumbs={[{ name: 'Kontakt' }]}
    media={false}
  >
    <a class="btn" href={site.phoneHref}><Icon name="phone" class="arrow" /> {site.phone}</a>
    <a class="btn btn--ghost" href="#wycena">Wyślij formularz</a>
  </PageHero>

  <section class="section pt-0">
    <div class="container">
      <div class="location">
        <div class="location__card reveal">
          <div>
            <h2>Biuro sprzedaży i godziny</h2>
          </div>
          <ul class="contact-list">
            <li>
              <Icon name="pin" class="" />
              <div><small>{site.address.place}</small><span>{site.address.street}, {site.address.postalCode} {site.address.city}</span></div>
            </li>
            <li>
              <Icon name="phone" class="" />
              <div><small>Telefon</small><a href={site.phoneHref}>{site.phone}</a></div>
            </li>
            <li>
              <Icon name="mail" class="" />
              <div><small>E-mail</small><a href={`mailto:${site.email}`}>{site.email}</a></div>
            </li>
            {site.hoursRows.length > 0 && (
              <li>
                <Icon name="clock" class="" />
                <div>
                  <small>Godziny pracy biura</small>
                  {site.hoursRows.map((h) => <span class="hours-row">{h.label}: {h.value}</span>)}
                </div>
              </li>
            )}
          </ul>
          <p class="muted small" style="margin:0">Na spotkanie w biurze najlepiej umówić się telefonicznie. Na pomiar przyjeżdżamy do Ciebie.</p>
          <div class="btn-row">
            <a class="btn btn--ghost" href={mapsUrl} target="_blank" rel="noopener"><Icon name="route" class="arrow" /> Wyznacz trasę</a>
            <a class="link-arrow" href={mapsUrl} target="_blank" rel="noopener">Opinie w Google <Icon name="external" class="" /></a>
            {social.map((s) => (
              <a class="link-arrow" href={s.href} target="_blank" rel="noopener">{s.label} <Icon name="external" class="" /></a>
            ))}
          </div>
        </div>
        <div class="reveal" style="min-height:380px;display:grid"><MapLink /></div>
      </div>
    </div>
  </section>

  <section class="section section--tight pt-0" id="doradcy">
    <div class="container">
      <div class="section-head">
        <h2>Z kim rozmawiasz</h2>
        <p>Zadzwoń bezpośrednio do osoby, która poprowadzi Twoje zamówienie.</p>
      </div>
      <div class="people reveal">
        {people.map((p) => (
          <div class="person">
            {(roles[p.name] || p.role) && <span class="crew-card__role">{roles[p.name] || p.role}</span>}
            <strong>{p.name}</strong>
            <a href={p.phoneHref}><Icon name="phone" class="" />{p.phone}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteForm title="Umów bezpłatny pomiar" />

  <section class="section section--tight" id="dane-firmy">
    <div class="container split" style="align-items:start">
      <div>
        <h2>Dane firmy</h2>
        <p class="muted" style="margin-top:20px">
          Dane do faktury i umowy. Inne sprawy załatwisz pod numerem <a href={site.phoneHref}>{site.phone}</a> albo mailowo: <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <dl class="company-data">
        <div><dt>Nazwa</dt><dd>{site.legalName}</dd></div>
        <div><dt>Siedziba</dt><dd>{site.address.street}, {site.address.postalCode} {site.address.city}</dd></div>
        <div><dt>NIP</dt><dd>{site.nip}</dd></div>
        <div><dt>REGON</dt><dd>{site.regon}</dd></div>
        <div><dt>Wspólnicy</dt><dd>{site.founders.join(', ')}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tight pt-0">
    <div class="container">
      <div class="related">
        <a href={url('/obszar-dzialania/')}><Icon name="mapa" class="icon" />Obszar działania: Płock i okolice</a>
        <a href={url('/konfigurator/')}><Icon name="konfigurator" class="icon" />Konfigurator okien</a>
        <a href={url('/montaz-okien/')}><Icon name="montaz" class="icon" />Jak montujemy</a>
        <a href={url('/realizacje/')}><Icon name="dom" class="icon" />Realizacje</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hours-row { display: block; }
</style>
