---
// Page shell: <head> with SEO tags (docs/seo-plan.md §5.2), global JSON-LD, header, footer,
// background grid lines, floating phone button.
//
// Props
//   title        <title> used 1:1 (no automatic "| Inter Windows" suffix). Fallback: site.defaultTitle
//   description  meta description (unique per page)
//   image        Open Graph image, root path (default /og.jpg, 1200×630); imageAlt for og:image:alt
//   ogType       'website' (default) | 'article'
//   noindex      true → <meta name="robots" content="noindex, follow"> AND the page is left out of
//                sitemap.xml automatically (integrations/sitemap.mjs reads the data-noindex marker)
//   updated      'YYYY-MM-DD' → og:updated_time and <lastmod> in sitemap.xml
//   schema       extra JSON-LD object(s) for this page (Service, ContactPage, BlogPosting…)
//   footerCta    false hides the CTA row in the footer
//
// Breadcrumbs (+ BreadcrumbList) and FAQ (+ FAQPage) output their own JSON-LD – see components.
import { url, withoutBase } from '../lib/url';
import { businessGraph } from '../lib/schema';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GridLines from '../components/GridLines.astro';
import CtaBar from '../components/CtaBar.astro';
import Rail from '../components/Rail.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { site, theme } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  updated?: string;
  schema?: object | object[];
  footerCta?: boolean;
}

const {
  title = site.defaultTitle,
  description = site.description,
  image = '/og.jpg',
  imageAlt = 'Czarny drewniany dom z białymi oknami ze szprosami – realizacja Inter Windows',
  ogType = 'website',
  noindex = false,
  updated,
  schema,
  footerCta = true,
} = Astro.props;

const path = withoutBase(Astro.url.pathname);
// canonical always points at the production domain (with trailing slash), also from a preview copy
const canonical = new URL(path, site.productionUrl).toString();
// og:image from the site actually being served, so shared preview links get a thumbnail too
const ogImage = new URL(url(image), Astro.site).toString();
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
// palette switcher (Granat | Mono) only in dev and preview builds; production uses `theme` from site.ts.
// Rail variant here (≥ 1280 px); the inline variant sits in the mobile menu and in the footer.
const themeSwitch = import.meta.env.DEV || isPreview;
const robots = isPreview ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="pl" class={themeSwitch ? 'has-theme-switch' : undefined} data-theme={theme} data-noindex={noindex ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('/favicon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {updated && <meta property="og:updated_time" content={updated} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {themeSwitch && (
      <script is:inline>
        // dev/preview only: palette chosen in the switcher (localStorage) or via ?motyw=, applied before paint
        (function () {
          var ok = function (v) { return v === 'profil' || v === 'mono'; };
          var t = new URLSearchParams(location.search).get('motyw');
          try {
            if (ok(t)) localStorage.setItem('iw-theme', t);
            else t = localStorage.getItem('iw-theme');
          } catch (e) {}
          if (ok(t)) document.documentElement.dataset.theme = t;
        })();
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(businessGraph())} />
    {extraSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>

    <GridLines />

    <Rail path={path} />

    <div class="site">
      <Header />
      <main id="tresc">
        <slot />
      </main>
      <Footer cta={footerCta} />
    </div>

    <CtaBar />
    {themeSwitch && <ThemeSwitch />}

    <!-- floating call button (desktop/tablet; on phones the sticky CtaBar replaces it) -->
    <a class="fab" href={site.phoneHref} aria-label={`Zadzwoń: ${site.phone}`} data-cta="fab-telefon">
      <span class="fab__label">Zadzwoń: {site.phone}</span>
      <span class="fab__btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg></span>
    </a>

    <script>
      // sticky header border
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // floating phone button: hidden while the footer (which has its own phone CTA) is in view,
      // or while an element marked [data-fab-avoid] (e.g. a photo caption) is in the bottom 30% of the viewport
      const fab = document.querySelector('.fab');
      const footer = document.querySelector('.site-footer');
      if (fab && footer) {
        const covering = new Map<Element, boolean>();
        const update = () => fab.classList.toggle('is-hidden', [...covering.values()].some(Boolean));
        const watch = (els: Element[], options?: IntersectionObserverInit) => {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => covering.set(e.target, e.isIntersecting));
            update();
          }, options);
          els.forEach((el) => io.observe(el));
        };
        watch([footer]);
        const avoid = [...document.querySelectorAll('[data-fab-avoid]')];
        if (avoid.length) watch(avoid, { rootMargin: '-70% 0px 0px 0px' });
      }

      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
