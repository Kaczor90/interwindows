---
// Schematic horizontal section through a window jamb showing the three sealing layers of a
// layered ("warm") installation. Generic illustration of the method – not a drawing of any
// specific product system. Used on /cieply-montaz-okien/.
//   <LayersDiagram />
const layers = [
  { n: 1, title: 'Warstwa wewnętrzna: paroszczelna', text: 'Taśma lub membrana od strony pokoju. Nie wpuszcza pary wodnej z wnętrza do szczeliny montażowej.' },
  { n: 2, title: 'Warstwa środkowa: izolacyjna', text: 'Pianka niskoprężna albo taśma rozprężna. Wypełnia szczelinę i odpowiada za izolację cieplną i akustyczną.' },
  { n: 3, title: 'Warstwa zewnętrzna: paroprzepuszczalna', text: 'Taśma lub membrana od strony elewacji. Chroni przed deszczem i wiatrem, a wilgoci pozwala odparować na zewnątrz.' },
];
---

<figure class="layers">
  <div class="layers__drawing">
    <svg viewBox="24 4 552 328" role="img" aria-labelledby="layers-title layers-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="layers-title">Ciepły montaż okna – przekrój przez ościeże</title>
      <desc id="layers-desc">Schemat: mur z ociepleniem, rama okna w otworze i szczelina montażowa uszczelniona trzema warstwami – paroszczelną od wnętrza, izolacyjną w środku i paroprzepuszczalną od zewnątrz.</desc>
      <defs>
        <pattern id="layers-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="10" class="l-hatch" />
        </pattern>
        <pattern id="layers-dots" width="12" height="12" patternUnits="userSpaceOnUse">
          <circle cx="3" cy="3" r="1.3" class="l-dot" />
          <circle cx="9" cy="9" r="1.3" class="l-dot" />
        </pattern>
        <pattern id="layers-foam" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="5" r="2.4" class="l-bubble" />
          <circle cx="11" cy="11" r="1.8" class="l-bubble" />
        </pattern>
      </defs>

      <text x="40" y="22" class="l-side">WNĘTRZE</text>
      <text x="560" y="22" class="l-side" text-anchor="end">ZEWNĄTRZ</text>

      <!-- wall + insulation -->
      <rect x="110" y="40" width="280" height="140" class="l-wall" />
      <rect x="110" y="40" width="280" height="140" fill="url(#layers-hatch)" />
      <rect x="390" y="40" width="110" height="140" class="l-insul" />
      <rect x="390" y="40" width="110" height="140" fill="url(#layers-dots)" />
      <text x="250" y="116" class="l-label" text-anchor="middle">mur</text>
      <text x="445" y="116" class="l-label" text-anchor="middle">ocieplenie</text>

      <!-- installation gap (layer 2) -->
      <rect x="240" y="180" width="110" height="28" class="l-gap" />
      <rect x="240" y="180" width="110" height="28" fill="url(#layers-foam)" />

      <!-- frame + glass -->
      <rect x="240" y="208" width="110" height="54" class="l-frame" />
      <text x="295" y="240" class="l-frame-label" text-anchor="middle">rama okna</text>
      <rect x="282" y="262" width="26" height="62" class="l-glass" />
      <text x="320" y="306" class="l-label">szyba</text>

      <!-- layer 1: vapour-tight (solid) · layer 3: vapour-open (dashed) -->
      <path d="M236 166 V222" class="l-in" />
      <path d="M354 166 V222" class="l-out" />

      <!-- markers -->
      <g class="l-mark">
        <circle cx="210" cy="194" r="12" /><text x="210" y="198.5" text-anchor="middle">1</text>
        <circle cx="295" cy="194" r="11" class="l-mark--light" /><text x="295" y="198.5" text-anchor="middle" class="l-mark-text--dark">2</text>
        <circle cx="380" cy="194" r="12" /><text x="380" y="198.5" text-anchor="middle">3</text>
      </g>
    </svg>
  </div>
  <figcaption>
    <ol class="layers__legend">
      {layers.map((l) => (
        <li><span class="layers__num" aria-hidden="true">{l.n}</span><div><strong>{l.title}</strong><span>{l.text}</span></div></li>
      ))}
    </ol>
    <p class="layers__note">Schemat poglądowy, bez zachowania skali. Rozmieszczenie warstw zależy od systemu i miejsca okna w murze.</p>
  </figcaption>
</figure>

<style>
  .layers { margin: 8px 0 28px; display: grid; gap: 20px; container-type: inline-size; }
  .layers__drawing { background: #fff; border: 1px solid var(--line); padding: clamp(8px, 2vw, 20px); }
  svg { width: 100%; height: auto; }
  .l-side { font: 600 11px/1 var(--font); letter-spacing: .16em; fill: var(--muted); }
  .l-label { font: 500 13px/1 var(--font); fill: var(--ink); }
  .l-frame-label { font: 600 12px/1 var(--font); fill: #fff; letter-spacing: .02em; }
  .l-wall { fill: var(--bg-soft); stroke: var(--line-strong); }
  .l-hatch { stroke: var(--line-strong); stroke-width: 1; }
  .l-insul { fill: #fff; stroke: var(--line-strong); }
  .l-dot { fill: var(--line-strong); }
  .l-gap { fill: color-mix(in srgb, var(--accent) 12%, #fff); }
  .l-bubble { fill: none; stroke: color-mix(in srgb, var(--accent) 45%, transparent); stroke-width: 1; }
  .l-frame { fill: var(--ink); }
  .l-glass { fill: color-mix(in srgb, var(--navy) 14%, #fff); stroke: var(--line-strong); }
  .l-in { stroke: var(--navy); stroke-width: 8; fill: none; }
  .l-out { stroke: var(--accent); stroke-width: 8; stroke-dasharray: 7 4; fill: none; }
  .l-mark circle { fill: var(--ink); }
  .l-mark text { font: 700 12px/1 var(--font); fill: #fff; }
  .l-mark .l-mark--light { fill: #fff; stroke: var(--ink); stroke-width: 1.2; }
  .l-mark .l-mark-text--dark { fill: var(--ink); }

  .layers__legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 28px; border-top: 1px solid var(--line-strong); }
  .layers__legend li { display: grid; grid-template-columns: 30px 1fr; gap: 14px; align-content: start; padding: 14px 0; border-bottom: 1px solid var(--line-strong); }
  @container (min-width: 640px) {
    .layers__legend { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .layers__legend li { grid-template-columns: 1fr; gap: 10px; }
  }
  .layers__num {
    width: 26px; height: 26px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--ink); color: #fff; font-size: .78rem; font-weight: 700;
  }
  .layers__legend strong { display: block; color: var(--ink); font-weight: 600; font-size: .94rem; }
  .layers__legend span:not(.layers__num) { font-size: .88rem; color: var(--muted); line-height: 1.6; }
  .layers__note { margin: 12px 0 0; font-size: .78rem; color: var(--muted); }
</style>
