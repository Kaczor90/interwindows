---
// Line icons. Product/process icons use a 64×64 grid, UI icons a 24×24 grid. Stroke ~1.5 px at display size.
// Colour comes from `currentColor` (ink by default; brass on hover/dark via CSS).
// Usage: <Icon name="okna-pcv" />  ·  <Icon name="phone" class="" />  ·  <Icon name="check" label="Tak" />
interface Props {
  name: string;
  class?: string;
  label?: string;
}
const { name, class: className = 'icon', label } = Astro.props;

const product: Record<string, string> = {
