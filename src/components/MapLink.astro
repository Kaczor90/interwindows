---
// Static "map" panel linking to Google Maps – no iframe, no third-party requests or cookies,
// no LCP cost (docs/seo-plan.md §5.7). Fills its parent; give the parent a height (min 340 px).
//   <MapLink />                                         office: Google Business Profile link from site.ts
//   <MapLink href="https://maps.google.com/?q=Gostynin" label="Gostynin" note="ok. 30 min z Płocka" />
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  href?: string;
  label?: string;
  note?: string;
}
const {
  href = site.googleMapsUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address.mapQuery)}`,
  label = `${site.address.street}, ${site.address.postalCode} ${site.address.city}`,
  note = 'Otwórz w Mapach Google i wyznacz trasę',
} = Astro.props;
---

<a class="map-link" href={href} target="_blank" rel="noopener">
  <svg class="map-link__bg" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g fill="none" stroke="#cdd2db" stroke-width="1">
      <path d="M-20 300 C 120 260, 220 320, 340 250 S 520 170, 640 190" stroke-width="10" stroke="#e7e9ee" />
      <path d="M-20 300 C 120 260, 220 320, 340 250 S 520 170, 640 190" />
      <path d="M120 -10 L 180 410" />
      <path d="M380 -10 C 360 120, 420 220, 400 410" />
      <path d="M-10 120 L 610 80" />
      <path d="M250 -10 L 300 160 L 520 410" stroke-dasharray="4 6" />
    </g>
    <g fill="#f7f8fa" stroke="#e7e9ee">
      <rect x="196" y="120" width="70" height="44" />
      <rect x="430" y="96" width="90" height="56" />
      <rect x="60" y="170" width="52" height="40" />
      <rect x="420" y="250" width="64" height="48" />
    </g>
  </svg>
  <span class="map-link__pin"><Icon name="pin" class="" /></span>
  <span class="map-link__card">
    <strong>{site.name}</strong>
    <span>{label}</span>
    <span class="map-link__cta">{note} <Icon name="external" class="" /></span>
  </span>
</a>

<style>
  .map-link {
    position: relative;
    display: grid; place-items: center; align-content: center; gap: 18px;
    min-height: 340px; height: 100%;
    overflow: hidden;
    background: var(--bg-soft);
    color: var(--ink);
    text-decoration: none;
  }
  .map-link__bg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map-link__pin {
    position: relative;
    width: 64px; height: 64px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--bg); border: 1px solid var(--ink);
    color: var(--ink);
    box-shadow: 0 0 0 8px var(--bg-soft), 0 0 0 9px var(--line-strong);
    transition: background .25s, color .25s;
  }
  .map-link__pin :global(svg) { width: 26px; height: 26px; }
  .map-link__card {
    position: relative;
    display: grid; gap: 2px; text-align: center;
    padding: 14px 22px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: .92rem;
  }
  .map-link__card strong { font-weight: 500; font-size: 1.15rem; line-height: 1.3; letter-spacing: -0.02em; }
  .map-link__cta { display: inline-flex; gap: 8px; align-items: center; justify-content: center; margin-top: 6px; font-weight: 600; font-size: .84rem; color: var(--navy); }
  .map-link__cta :global(svg) { width: 14px; height: 14px; }
  .map-link:hover .map-link__pin { background: var(--ink); color: #fff; }
  .map-link:hover .map-link__cta { text-decoration: underline; text-underline-offset: 3px; }
</style>
