---
// Installation process as numbered steps (default data: src/data/montaz.ts).
// layout "row" = five columns on desktop with brass ticks; "list" = vertical list with numbers.
// A step with `image` shows the picture instead of the icon (`images={false}` = icons only).
// Steps with confirmed:false show a small "do potwierdzenia" tag until the client confirms them.
//   <ProcessSteps />   ·   <ProcessSteps layout="list" steps={mySteps} images={false} />
import { url } from '../lib/url';
import Icon from './Icon.astro';
import { montazSteps, type Step } from '../data/montaz';

interface Props {
  steps?: Step[];
  layout?: 'row' | 'list';
  images?: boolean;
}
const { steps = montazSteps, layout = 'row', images = true } = Astro.props;
const small = (src: string) => src.replace(/\.webp$/, '-800.webp');
---

<ol class:list={['steps', { 'steps--row': layout === 'row' }]}>
  {steps.map((s, i) => (
    <li class="step reveal">
      <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="step__body">
        {images && s.image ? (
          <figure class="photo step__img">
            <img src={url(small(s.image.src))} alt={s.image.alt} width={s.image.width} height={s.image.height} loading="lazy" />
          </figure>
        ) : (
          <Icon name={s.icon} />
        )}
        <h3>
          <span class="sr-only">Krok {i + 1}: </span>{s.title}
          {!s.confirmed && <span class="tbc" title="Treść czeka na potwierdzenie przez Inter Windows">do potwierdzenia</span>}
        </h3>
        <p>{s.text}</p>
        {s.proof && <p class="step__proof"><Icon name="check" class="" /><span>{s.proof}</span></p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .step__img { aspect-ratio: 4 / 3; margin: 18px 0 18px; }
  .step__img img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 1000px) { .step__img { aspect-ratio: auto; height: 150px; } }
  @media (max-width: 999px) {
    .step__img { aspect-ratio: 16 / 9; margin-top: 4px; max-width: 520px; }
  }
</style>
