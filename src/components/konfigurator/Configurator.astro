---
// Window configurator (prototype). Static markup for every step and option (rendered from
// src/data/konfigurator.ts), enhanced by src/scripts/konfigurator.ts: state, stepper, live SVG
// preview (./rysunek.ts), project list, summary and the request form (./RequestForm.astro).
// Elements created by the script are styled with :global() under the component's own classes.
import { url } from '../../lib/url';
import Icon from '../Icon.astro';
import OptionGroup from './OptionGroup.astro';
import RequestForm from './RequestForm.astro';
import { drawItem } from './rysunek';
import { site } from '../../data/site';
import {
  steps,
  productTypes,
  contexts,
  templates,
  systems,
  finishes,
  panes,
  glassToggles,
  safetyGlass,
  barKinds,
  BARS_MAX,
  hinges,
  handles,
  security,
  shadings,
  drives,
  screens,
  sills,
  mountings,
  removal,
  OWN_CREW_NOTE,
  defaultItem,
  type Item,
} from '../../data/konfigurator';

const num = (i: number) => String(i + 1).padStart(2, '0');
const total = steps.length;
const thumbs: Record<string, string> = Object.fromEntries(
  templates.map((t) => {
    const it: Item = { ...defaultItem(t.type), template: t.id, openings: [...t.openings] };
    return [t.id, drawItem(it, { view: 'in', mode: 'thumb', id: `th-${t.id}`, neutral: true })];
  }),
);
// first paint (before the script runs): default item
const firstDrawing = drawItem(defaultItem(), { view: 'in', mode: 'full', id: 'kfp' });
const finishOpts = finishes.map((f) => ({
  value: f.id,
  label: f.label,
  desc: f.code ?? (f.kind === 'okleina' ? 'okleina' : f.kind === 'lakier' ? 'drewno' : undefined),
  swatch: { hex: f.hex, grain: f.grain },
  attrs: { 'data-systems': f.systems.join(' ') },
}));
const countOpts = Array.from({ length: BARS_MAX + 1 }, (_, i) => i);
const stepHead = (i: number) => ({ id: `kf-h-${steps[i].id}`, n: `Krok ${num(i)} z ${total}`, title: steps[i].title });
---

<div class="kf" data-kf data-step="typ">
  <noscript>
    <p class="kf-noscript">
      Konfigurator działa w przeglądarce z włączonym JavaScriptem. Możesz też zadzwonić:
      <a href={site.phoneHref}>{site.phone}</a> albo wysłać <a href={url('/kontakt/#wycena')}>formularz kontaktowy</a>.
    </p>
  </noscript>

  <nav class="kf-steps" aria-label="Kroki konfiguratora">
    <ol class="kf-steps__list">
      {steps.map((s, i) => (
        <li>
          <button type="button" class="kf-steps__btn" data-goto={i} aria-current={i === 0 ? 'step' : undefined}>
            <span class="kf-steps__num" aria-hidden="true">{num(i)}</span>
            <span class="kf-steps__label"><span class="sr-only">Krok {i + 1}: </span>{s.label}</span>
          </button>
        </li>
      ))}
    </ol>
  </nav>

  <div class="kf-layout">
    <!-- preview + summary (sticky) -->
    <div class="kf-aside" data-kf-aside>
      <figure class="kf-preview">
        <div class="kf-preview__bar">
          <p class="kf-preview__pos" data-kf-pos>Pozycja 1 z 1</p>
          <fieldset class="kf-seg">
            <legend class="sr-only">Widok rysunku</legend>
            <label><input type="radio" name="kf-view" value="in" data-kf-view checked /><span>Od wewnątrz</span></label>
            <label><input type="radio" name="kf-view" value="out" data-kf-view /><span>Z zewnątrz</span></label>
          </fieldset>
        </div>
        <div class="kf-preview__draw" data-kf-draw set:html={firstDrawing} />
        <figcaption class="kf-preview__cap">
          <p class="kf-preview__desc" data-kf-desc aria-live="polite"></p>
          <details class="kf-legend">
            <summary>Jak czytać rysunek</summary>
            <ul>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 3 4 12l16 9" /></svg>
                <span>Wierzchołek trójkąta wskazuje stronę zawiasów (skrzydło rozwierne).</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4l9 16 9-16" /></svg>
                <span>Linie zbiegające się u dołu: uchył.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15V12h14M15 8l4 4-4 4" /></svg>
                <span>Strzałka: skrzydło przesuwne (HST). F: szyba stała.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18" /><path d="M3 16h18" stroke-dasharray="3 3" /></svg>
                <span>Linia ciągła: skrzydło otwiera się do patrzącego (widok od wewnątrz). Przerywana: od patrzącego.</span>
              </li>
            </ul>
            <p>Klamkę i zawiasy widać od wewnątrz. Roletę, moskitierę i parapet zewnętrzny – z zewnątrz. Kolory i szerokości profili są poglądowe.</p>
          </details>
        </figcaption>
      </figure>

      <section class="kf-sum" aria-labelledby="kf-sum-title">
        <h2 class="kf-sum__title" id="kf-sum-title">Twoja konfiguracja</h2>
        <dl class="kf-sum__list" data-kf-sum></dl>
        <p class="kf-sum__note">Projekt wstępny – dokładne wymiary i wycenę przygotuje doradca po pomiarze.</p>
      </section>
    </div>

    <!-- steps -->
    <div class="kf-main" data-kf-main>
      <!-- 1. typ -->
      <section class="kf-step" data-step="typ" aria-labelledby={stepHead(0).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(0).n}</span>
          <h2 id={stepHead(0).id} tabindex="-1">{stepHead(0).title}</h2>
        </header>
        <OptionGroup
          legend="Rodzaj"
          name="kf-type"
          k="type"
          options={productTypes.map((p) => ({ value: p.id, label: p.label, desc: p.desc, tbc: p.tbc }))}
        />
        <OptionGroup
          legend="Inwestycja (dotyczy całego projektu)"
          name="kf-context"
          k="@context"
          variant="compact"
          options={contexts.map((c) => ({ value: c.id, label: c.label, desc: c.desc }))}
        />
        <div class="field kf-name">
          <label for="kf-name">Nazwa pozycji <span>(opcjonalnie)</span></label>
          <input id="kf-name" type="text" data-k="name" maxlength="40" autocomplete="off" placeholder="np. Salon, Sypialnia 1, Kuchnia" />
        </div>
      </section>

      <!-- 2. kształt -->
      <section class="kf-step" data-step="ksztalt" hidden aria-labelledby={stepHead(1).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(1).n}</span>
          <h2 id={stepHead(1).id} tabindex="-1">{stepHead(1).title}</h2>
        </header>
        <OptionGroup
          legend="Szablon"
          name="kf-template"
          k="template"
          variant="thumbs"
          options={templates.map((t) => ({ value: t.id, label: t.label, thumb: thumbs[t.id], tbc: t.tbc, attrs: { 'data-types': t.type } }))}
        />
        <fieldset class="kf-group">
          <legend class="kf-group__legend">Sposób otwierania <span class="tbc">nazewnictwo L/P do potwierdzenia</span></legend>
          <p class="kf-hint">
            Kliknij skrzydło na rysunku, żeby zmienić sposób otwierania, albo wybierz go z listy. Numeracja i strony (lewe, prawe)
            – patrząc od wewnątrz.
          </p>
          <div class="kf-openings" data-kf-openings></div>
        </fieldset>
      </section>

      <!-- 3. wymiary -->
      <section class="kf-step" data-step="wymiary" hidden aria-labelledby={stepHead(2).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(2).n}</span>
          <h2 id={stepHead(2).id} tabindex="-1">{stepHead(2).title}</h2>
        </header>
        <OptionGroup
          legend="Wymiary okna"
          name="kf-size"
          k="sizeMode"
          options={[
            { value: 'pomiar', label: 'Wymiary poda nasz technik przy pomiarze', desc: 'Najprostsza droga. Pomiar jest bezpłatny i niezobowiązujący.' },
            { value: 'wlasne', label: 'Znam orientacyjne wymiary', desc: 'Rysunek pokaże proporcje. Ostateczne wymiary i tak ustala technik.' },
          ]}
        />
        <div class="kf-dims" data-kf-dims hidden>
          <div class="kf-dims__row">
            <div class="field">
              <label for="kf-w">Szerokość (mm)</label>
              <input id="kf-w" type="number" inputmode="numeric" step="10" data-k="w" aria-describedby="kf-dims-hint kf-dims-err" />
            </div>
            <span class="kf-dims__x" aria-hidden="true">×</span>
            <div class="field">
              <label for="kf-h">Wysokość (mm)</label>
              <input id="kf-h" type="number" inputmode="numeric" step="10" data-k="h" aria-describedby="kf-dims-hint kf-dims-err" />
            </div>
          </div>
          <p class="kf-hint" id="kf-dims-hint" data-kf-limits></p>
          <p class="kf-error" id="kf-dims-err" data-kf-dims-err aria-live="polite"></p>
        </div>
      </section>

      <!-- 4. system -->
      <section class="kf-step" data-step="system" hidden aria-labelledby={stepHead(3).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(3).n}</span>
          <h2 id={stepHead(3).id} tabindex="-1">{stepHead(3).title}</h2>
        </header>
        <OptionGroup
          legend="System"
          name="kf-system"
          k="system"
          hint="Parametry konkretnego zestawu (Uw, pakiet szyb, wymiary graniczne) podamy w ofercie, na podstawie kart producenta."
          options={systems.map((s) => ({ value: s.id, label: s.label, sub: `${s.name} · ${s.line}`, desc: s.desc, points: s.points }))}
        />
        <p class="kf-hint kf-hst-note" data-kf-hst-note hidden>
          Drzwi HST: system i wymiary graniczne dobierzemy do otworu. <span class="tbc">dostępność do potwierdzenia</span>
        </p>
      </section>

      <!-- 5. kolor -->
      <section class="kf-step" data-step="kolor" hidden aria-labelledby={stepHead(4).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(4).n}</span>
          <h2 id={stepHead(4).id} tabindex="-1">{stepHead(4).title}</h2>
        </header>
        <OptionGroup legend="Kolor od zewnątrz" name="kf-color-out" k="colorOut" variant="swatch" tbc="lista do potwierdzenia dla systemu" options={finishOpts} />
        <OptionGroup legend="Kolor od wewnątrz" name="kf-color-in" k="colorIn" variant="swatch" options={finishOpts} />
        <div class="kf-row">
          <button type="button" class="btn btn--ghost btn--sm" data-kf-samecolor>Ten sam kolor od wewnątrz</button>
          <p class="kf-hint">Kolory na ekranie są przybliżone. Próbki pokażemy przy pomiarze.</p>
        </div>
      </section>

      <!-- 6. szyby -->
      <section class="kf-step" data-step="szyby" hidden aria-labelledby={stepHead(5).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(5).n}</span>
          <h2 id={stepHead(5).id} tabindex="-1">{stepHead(5).title}</h2>
        </header>
        <OptionGroup legend="Pakiet szyb" name="kf-pane" k="glass.pane" variant="compact" options={panes.map((p) => ({ value: p.id, label: p.label, desc: p.desc }))} />
        <OptionGroup
          legend="Dodatkowo"
          name="kf-glass"
          type="checkbox"
          variant="compact"
          options={glassToggles.map((g) => ({ value: g.id, label: g.label, desc: g.desc, tbc: g.tbc, k: `glass.${g.id}` }))}
        />
        <OptionGroup legend="Szyba bezpieczna" name="kf-safety" k="glass.safety" variant="compact" options={safetyGlass.map((s) => ({ value: s.id, label: s.label, desc: s.desc, tbc: s.tbc }))} />
        <OptionGroup legend="Szprosy" name="kf-bars" k="bars.kind" variant="compact" options={barKinds.map((b) => ({ value: b.id, label: b.label, desc: b.desc, tbc: b.tbc }))} />
        <div class="kf-bars" data-kf-bars hidden>
          <div class="field">
            <label for="kf-bars-v">Szprosy pionowe w polu</label>
            <select id="kf-bars-v" data-k="bars.v">{countOpts.map((c) => <option value={c}>{c}</option>)}</select>
          </div>
          <div class="field">
            <label for="kf-bars-h">Szprosy poziome w polu</label>
            <select id="kf-bars-h" data-k="bars.h">{countOpts.map((c) => <option value={c}>{c}</option>)}</select>
          </div>
        </div>
      </section>

      <!-- 7. okucia -->
      <section class="kf-step" data-step="okucia" hidden aria-labelledby={stepHead(6).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(6).n}</span>
          <h2 id={stepHead(6).id} tabindex="-1">{stepHead(6).title}</h2>
        </header>
        <OptionGroup legend="Zawiasy" name="kf-hinges" k="hardware.hinges" variant="compact" options={hinges.map((h) => ({ value: h.id, label: h.label, desc: h.desc, tbc: h.tbc }))} />
        <OptionGroup
          legend="Kolor klamki"
          name="kf-handle"
          k="hardware.handle"
          variant="swatch"
          tbc="dostępność do potwierdzenia"
          options={handles.map((h) => ({ value: h.id, label: h.label, swatch: { hex: h.hex } }))}
        />
        <OptionGroup legend="Bezpieczeństwo" name="kf-rc" k="hardware.rc" variant="compact" options={security.map((s) => ({ value: s.id, label: s.label, desc: s.desc, tbc: s.tbc }))} />
        <p class="kf-hint kf-note" data-kf-rc-hint hidden>
          Klasa RC2 obejmuje całe okno: okucia, klamkę z zamkiem lub przyciskiem i szybę P4A. Doradca sprawdzi, czy wybrany system i układ skrzydeł są dostępne w tej klasie.
        </p>
      </section>

      <!-- 8. dodatki -->
      <section class="kf-step" data-step="dodatki" hidden aria-labelledby={stepHead(7).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(7).n}</span>
          <h2 id={stepHead(7).id} tabindex="-1">{stepHead(7).title}</h2>
        </header>
        <OptionGroup legend="Osłona zewnętrzna" name="kf-shading" k="extras.shading" variant="compact" options={shadings.map((s) => ({ value: s.id, label: s.label, desc: s.desc, tbc: s.tbc }))} />
        <OptionGroup legend="Napęd osłony" name="kf-drive" k="extras.drive" variant="compact" attrs={{ 'data-kf-drive': '' }} options={drives.map((d) => ({ value: d.id, label: d.label, desc: d.desc }))} />
        <OptionGroup
          legend="Moskitiera"
          name="kf-screen"
          k="extras.screen"
          variant="compact"
          options={screens.map((s) => ({ value: s.id, label: s.label, desc: s.desc, tbc: s.tbc, attrs: { 'data-types': s.types.join(' ') } }))}
        />
        <OptionGroup
          legend="Parapety"
          name="kf-sills"
          type="checkbox"
          variant="compact"
          attrs={{ 'data-kf-sills': '' }}
          options={sills.map((s) => ({ value: s.id, label: s.label, desc: s.desc, tbc: s.tbc, k: `extras.${s.id}` }))}
        />
        <p class="kf-hint" data-kf-sill-note hidden>Drzwi balkonowe i przesuwne mają próg zamiast parapetu. Wykończenie progu omówimy przy pomiarze.</p>
        <p class="kf-hint">Rolety i żaluzje dobierzemy kolorem do okien i elewacji. Zobacz <a href={url('/rolety-zewnetrzne/')}>rolety zewnętrzne</a> i <a href={url('/zaluzje-fasadowe/')}>żaluzje fasadowe</a>.</p>
      </section>

      <!-- 9. montaż -->
      <section class="kf-step" data-step="montaz" hidden aria-labelledby={stepHead(8).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(8).n}</span>
          <h2 id={stepHead(8).id} tabindex="-1">{stepHead(8).title}</h2>
        </header>
        <div class="kf-crew">
          <Icon name="ekipa" class="kf-crew__icon" />
          <div>
            <strong>{OWN_CREW_NOTE}</strong>
            <span>Za pomiar, dobór sposobu osadzenia i montaż odpowiada jedna firma. <a href={url('/montaz-okien/')}>Jak montujemy</a></span>
          </div>
        </div>
        <OptionGroup legend="Sposób montażu" name="kf-mount" k="mount" variant="compact" options={mountings.map((m) => ({ value: m.id, label: m.label, desc: m.desc, tbc: m.tbc }))} />
        <OptionGroup
          legend="Wymiana okien (dotyczy całego projektu)"
          name="kf-removal"
          type="checkbox"
          variant="compact"
          attrs={{ 'data-kf-removal': '' }}
          options={[{ value: removal.id, label: removal.label, tbc: removal.tbc, k: '@demontaz' }]}
        />
        <p class="kf-hint">Więcej o warstwowym uszczelnieniu okna: <a href={url('/cieply-montaz-okien/')}>ciepły montaż okien</a>.</p>
      </section>

      <!-- 10. projekt -->
      <section class="kf-step" data-step="projekt" hidden aria-labelledby={stepHead(9).id}>
        <header class="kf-step__head kf-step__head--split">
          <div>
            <span class="kf-step__num">{stepHead(9).n}</span>
            <h2 id={stepHead(9).id} tabindex="-1">{stepHead(9).title}</h2>
          </div>
          <p class="kf-total" data-kf-total></p>
        </header>
        <ul class="kf-list" data-kf-list></ul>
        <div class="kf-row kf-row--actions">
          <button type="button" class="btn" data-kf-add>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Dodaj kolejne okno
          </button>
          <button type="button" class="btn btn--ghost" data-kf-copy>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
            Skopiuj link do projektu
          </button>
          <button type="button" class="kf-textbtn" data-kf-reset>Zacznij od nowa</button>
        </div>
        <div class="kf-linkbox" data-kf-linkbox hidden>
          <label for="kf-link">Link do projektu</label>
          <input id="kf-link" type="text" readonly />
        </div>
        <p class="kf-status" data-kf-status role="status" aria-live="polite"></p>
        <p class="kf-hint">Projekt zapisuje się w tej przeglądarce. Link otworzy go na innym urządzeniu – możesz go też wysłać domownikom.</p>
      </section>

      <!-- 11. wysyłka -->
      <section class="kf-step" data-step="wysylka" hidden aria-labelledby={stepHead(10).id}>
        <header class="kf-step__head">
          <span class="kf-step__num">{stepHead(10).n}</span>
          <h2 id={stepHead(10).id} tabindex="-1">{stepHead(10).title}</h2>
        </header>
        <div class="kf-send">
          <div class="kf-send__review">
            <p class="kf-hint kf-send__lead">
              Sprawdź zestawienie. Projekt jest wstępny – dokładne wymiary i wycenę przygotuje doradca po pomiarze.
              Pomiar i wycena są bezpłatne.
            </p>
            <p class="kf-error" data-kf-review-err aria-live="polite"></p>
            <div class="kf-review" data-kf-review></div>
            <details class="kf-plain">
              <summary>Zobacz treść, którą otrzyma doradca</summary>
              <pre data-kf-plain></pre>
            </details>
          </div>
          <div class="form-panel kf-send__form">
            <h3 class="kf-send__title">Umów konsultację i pomiar</h3>
            <p class="kf-hint">Oddzwonimy, omówimy projekt i umówimy bezpłatny pomiar.</p>
            <RequestForm />
          </div>
        </div>
      </section>

      <div class="kf-nav" data-fab-avoid>
        <button type="button" class="btn btn--ghost btn--sm kf-nav__btn" data-kf-prev>
          <Icon name="arrow-left" class="" /> Wstecz
        </button>
        <span class="kf-nav__count" data-kf-count aria-hidden="true">1 / {total}</span>
        <button type="button" class="btn btn--sm kf-nav__btn" data-kf-next>
          <span data-kf-next-label>Dalej</span> <Icon name="arrow" class="arrow" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/konfigurator';
</script>

<style>
  .kf [hidden] { display: none !important; }
  .kf { position: relative; }
  .kf-noscript { padding: 16px 20px; border: 1px solid var(--line-strong); background: var(--bg-soft); margin: 0 0 24px; }

  /* ---------- stepper ---------- */
  .kf-steps {
    /* containing block for the .sr-only spans, so they stay inside the horizontal scroller */
    position: relative;
    margin: 0 0 clamp(20px, 3vw, 32px);
    border-top: 1px solid var(--line-strong);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .kf-steps::-webkit-scrollbar { display: none; }
  .kf-steps__list { list-style: none; margin: 0; padding: 0; display: flex; min-width: max-content; }
  .kf-steps__list li { flex: 1 0 auto; }
  .kf-steps__btn {
    display: grid; gap: 2px; justify-items: start;
    width: 100%;
    margin-top: -1px;
    padding: 12px 18px 10px 0;
    border: 0; border-top: 2px solid transparent;
    background: none;
    font: inherit; text-align: left;
    color: var(--muted);
    cursor: pointer;
    transition: border-color .2s var(--ease), color .2s;
  }
