---
// Palette switcher for comparing the two colour themes live ("Granat | Mono"; theme keys 'profil' | 'mono').
// Rendered ONLY in dev and preview builds (PUBLIC_PREVIEW=true); production builds use `theme` from
// src/data/site.ts and contain neither this control nor the switching script.
// The choice is stored in localStorage ('iw-theme') and mirrored in the ?motyw= URL parameter;
// the inline script in Base.astro <head> applies it before the first paint.
//
// It must never cover content or controls, so it has no floating position over the page:
//   variant="rail"   (Base.astro)   ≥ 1280 px: a round button inside the left side-rail column; the options
//                                   open next to it only on click. Hidden below 1280 px.
//   variant="inline" (Header mobile menu, Footer bottom row): a plain row "Motyw (podgląd): Granat | Mono".
import Icon from './Icon.astro';

interface Props {
  variant?: 'rail' | 'inline';
  /** inline: light text for dark backgrounds (footer) */
  onDark?: boolean;
}
const { variant = 'rail', onDark = false } = Astro.props;
const options = [
  { key: 'profil', label: 'Granat' },
  { key: 'mono', label: 'Mono' },
];
const id = `theme-switch-options-${variant}`;
---

{variant === 'rail' ? (
  <div class="theme-switch" data-theme-switch>
    <button class="theme-switch__toggle" type="button" aria-expanded="false" aria-controls={id} aria-label="Motyw kolorystyczny (podgląd)">
      <Icon name="contrast" class="" />
    </button>
    <div class="theme-switch__options" id={id} role="group" aria-label="Motyw kolorystyczny (podgląd)">
      <span class="theme-switch__label" aria-hidden="true">Motyw</span>
      {options.map((o) => <button type="button" data-theme-set={o.key} aria-pressed="false">{o.label}</button>)}
    </div>
  </div>
) : (
  <div class:list={['theme-inline', { 'theme-inline--dark': onDark }]} role="group" aria-label="Motyw kolorystyczny (podgląd)">
    <span class="theme-inline__label">Motyw (podgląd):</span>
    {options.map((o) => <button type="button" data-theme-set={o.key} aria-pressed="false">{o.label}</button>)}
  </div>
)}

<style>
  /* ---------- rail variant: only where the side rail exists ---------- */
  .theme-switch { display: none; }
  @media (min-width: 1280px) {
    .theme-switch {
      display: block;
      position: fixed;
      left: calc((var(--rail) - 40px) / 2);
      bottom: 20px;
      z-index: 47;
      font-size: .74rem;
    }
  }
  .theme-switch__toggle {
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }
  .theme-switch__toggle :global(svg) { width: 18px; height: 18px; }
  .theme-switch__toggle:hover { border-color: var(--ink); }
  .theme-switch__toggle[aria-expanded='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .theme-switch__options {
    position: absolute; left: calc(100% + 10px); bottom: 0;
    display: none; align-items: center; gap: 2px;
    padding: 4px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }
  .theme-switch.is-open .theme-switch__options { display: inline-flex; }
  .theme-switch__label { padding: 0 8px 0 10px; color: var(--muted); font-weight: 600; }
  .theme-switch__options button {
    min-height: 32px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 .74rem/1 var(--font);
    cursor: pointer;
  }
  .theme-switch__options button:hover { background: var(--bg-soft); }
  .theme-switch__options button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }

  /* ---------- inline variant (mobile menu, footer) ---------- */
  .theme-inline { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: .8rem; }
  .theme-inline__label { margin-right: 4px; color: var(--muted); font-weight: 600; }
  .theme-inline button {
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 .78rem/1 var(--font);
    cursor: pointer;
  }
  .theme-inline button:hover { border-color: var(--ink); }
  .theme-inline button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .theme-inline--dark .theme-inline__label { color: rgba(255, 255, 255, .55); }
  .theme-inline--dark button { color: #fff; border-color: rgba(255, 255, 255, .3); }
  .theme-inline--dark button:hover { border-color: #fff; }
  .theme-inline--dark button[aria-pressed='true'] { background: #fff; border-color: #fff; color: var(--dark); }

  @media print { .theme-switch, .theme-inline { display: none; } }
</style>

<script>
  const KEY = 'iw-theme';
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-set]')];
  const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === root.dataset.theme)));

  // rail variant: the options open next to the round button
  const box = document.querySelector<HTMLElement>('[data-theme-switch]');
  const toggle = box?.querySelector<HTMLButtonElement>('.theme-switch__toggle');
  const setOpen = (open: boolean) => {
    box?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => {
    const open = !box?.classList.contains('is-open');
    setOpen(open);
    if (open) box?.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
  });
  document.addEventListener('click', (e) => {
    if (box?.classList.contains('is-open') && !box.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const theme = b.dataset.themeSet!;
      root.dataset.theme = theme;
      try {
        localStorage.setItem(KEY, theme);
      } catch {
        /* storage blocked (private mode) – the switch still works for this page view */
      }
      const u = new URL(location.href);
      u.searchParams.set('motyw', theme);
      history.replaceState(history.state, '', u);
      sync();
      if (box?.contains(b)) {
        setOpen(false);
        toggle?.focus();
      }
    }),
  );
  sync();
</script>
