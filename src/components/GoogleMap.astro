---
// Real Google Map of the office: plain iframe embed, no API key, no JS. Query and zoom: site.mapEmbed.
// Lazy-loaded (use it below the fold only) inside a fixed aspect-ratio box, so it never shifts the layout (CLS).
// Greyscale to match the calm palette; full colour on hover / keyboard focus. Third party: Google may set
// cookies and sees the visitor's IP when the map loads – disclosed in /polityka-prywatnosci/ (section 6).
//   <GoogleMap />                    4:3 on phones, square from 900 px (home „Gdzie pracujemy”)
//   <GoogleMap fill />               4:3 on phones, from 900 px stretches to the grid row (min. 380 px);
//                                    put it directly in a grid / flex parent
//   <GoogleMap zoom={10} />          wider view, e.g. the whole area served
// The bar under the map links to the Google Business Profile (site.googleMapsUrl).
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  zoom?: number;
  fill?: boolean;
  class?: string;
}
const { zoom = site.mapEmbed.zoom, fill = false, class: className = '' } = Astro.props;

const src = `https://maps.google.com/maps?q=${encodeURIComponent(site.mapEmbed.query)}&z=${zoom}&hl=pl&output=embed`;
const address = `${site.address.street}, ${site.address.postalCode} ${site.address.city}`;
const openHref =
  site.googleMapsUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address.mapQuery)}`;
---

<figure class:list={['gmap', fill && 'gmap--fill', className]}>
  <div class="gmap__frame">
    <span class="gmap__placeholder" aria-hidden="true"><Icon name="pin" class="" /></span>
    <iframe
      src={src}
      title={`Mapa: ${site.name}, ${address}`}
      width="600"
      height="450"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption class="gmap__bar">
    <span class="gmap__addr">{address}</span>
    <a class="gmap__open" href={openHref} target="_blank" rel="noopener">Otwórz w Mapach Google <Icon name="external" class="" /></a>
  </figcaption>
</figure>

<style>
  .gmap { margin: 0; display: flex; flex-direction: column; min-width: 0; }
  .gmap__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--bg-soft);
  }
  @media (min-width: 900px) {
    .gmap:not(.gmap--fill) .gmap__frame { aspect-ratio: 1; }
    .gmap--fill .gmap__frame { aspect-ratio: auto; flex: 1 1 auto; min-height: 380px; }
  }
  /* shown until the lazy iframe has painted over it */
  .gmap__placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: var(--line-strong); }
  .gmap__placeholder :global(svg) { width: 40px; height: 40px; }
  .gmap__frame iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border: 0;
    filter: grayscale(1) contrast(1.05);
  }
  .gmap__frame:hover iframe,
  .gmap__frame:focus-within iframe { filter: none; }
  @media (prefers-reduced-motion: no-preference) {
    .gmap__frame iframe { transition: filter .45s var(--ease); }
  }

  .gmap__bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 18px;
    padding: 12px 16px;
    border: 1px solid var(--line); border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--bg);
    font-size: .84rem;
  }
  .gmap__addr { color: var(--muted); }
  .gmap__open {
    display: inline-flex; gap: 8px; align-items: center;
    font-weight: 600; color: var(--navy);
    text-decoration: none;
  }
  .gmap__open :global(svg) { width: 14px; height: 14px; }
  .gmap__open:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
