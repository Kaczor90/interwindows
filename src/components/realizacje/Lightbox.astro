---
// Light photo viewer. Put it once on a page; it opens for every link marked `data-lb` (the link's href
// is the large image, `data-caption` the caption). Without JS the links simply open the image file.
// Navigation stays inside the closest `[data-lb-group]` and skips items hidden by the hub filters.
//   <a href="/img/…/x.webp" data-lb data-caption="Opis">…</a>
//   <Lightbox />
---

<dialog class="lb" aria-label="Podgląd zdjęcia" data-lightbox>
  <figure class="lb__figure">
    <img class="lb__img" alt="" />
    <figcaption class="lb__caption">
      <span class="lb__text"></span>
      <span class="lb__count"></span>
    </figcaption>
  </figure>
  <button type="button" class="lb__btn lb__close" data-lb-close aria-label="Zamknij podgląd">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label="Poprzednie zdjęcie">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
  </button>
  <button type="button" class="lb__btn lb__next" data-lb-next aria-label="Następne zdjęcie">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('.lb__img')!;
    const text = dialog.querySelector<HTMLElement>('.lb__text')!;
    const counter = dialog.querySelector<HTMLElement>('.lb__count')!;
    let items: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      img.src = a.href;
      img.alt = a.dataset.caption ?? '';
      text.textContent = a.dataset.caption ?? '';
      counter.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
      dialog.classList.toggle('is-single', items.length < 2);
    };

    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lb]');
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const group = a.closest('[data-lb-group]') ?? document;
      // only items that are currently visible (the hub filter hides some with display:none)
      items = [...group.querySelectorAll<HTMLAnchorElement>('a[data-lb]')].filter((el) => el.offsetParent !== null);
      show(Math.max(0, items.indexOf(a)));
      dialog.showModal();
    });

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // click on the backdrop (outside the photo and the buttons) closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => img.removeAttribute('src'));
  }
</script>

<style>
  .lb {
    width: 100vw; height: 100vh; max-width: none; max-height: none;
    margin: 0; padding: 56px 72px 24px;
    border: 0;
    background: color-mix(in srgb, var(--dark) 95%, transparent);
    color: #fff;
  }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop { background: color-mix(in srgb, var(--dark) 60%, transparent); }
  .lb__figure { margin: 0; display: grid; gap: 14px; justify-items: center; max-width: 100%; max-height: 100%; }
  .lb__img { max-width: 100%; max-height: calc(100vh - 140px); width: auto; height: auto; object-fit: contain; background: rgba(255, 255, 255, .04); }
  .lb__caption { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; font-size: .88rem; color: rgba(255, 255, 255, .78); text-align: center; max-width: 720px; }
  .lb__count { color: rgba(255, 255, 255, .5); font-variant-numeric: tabular-nums; }
  .lb__btn {
    position: absolute;
    display: grid; place-items: center;
    width: 48px; height: 48px;
    padding: 0;
    color: #fff;
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .22);
    border-radius: 50%;
    cursor: pointer;
    transition: background .2s, border-color .2s;
  }
  .lb__btn:hover { background: rgba(255, 255, 255, .18); border-color: rgba(255, 255, 255, .5); }
  .lb__btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .lb__btn svg { width: 22px; height: 22px; }
  .lb__close { top: 12px; right: 12px; }
  .lb__prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .lb__next { right: 12px; top: 50%; transform: translateY(-50%); }
  .lb.is-single .lb__prev, .lb.is-single .lb__next { display: none; }
  @media (max-width: 640px) {
    .lb { padding: 64px 12px 84px; }
    .lb__prev, .lb__next { top: auto; bottom: 16px; transform: none; }
    .lb__prev { left: calc(50% - 60px); }
    .lb__next { right: calc(50% - 60px); }
  }
</style>
