---
// Card of one project (src/data/realizacje.ts) – used on /realizacje/ and in "Podobne realizacje".
//   <ProjectCard r={r} />                     standard card
//   <ProjectCard r={r} wide />                wide variant (first card on the hub, landscape on desktop)
//   <ProjectCard r={r} heading="h3" />        heading level (default h3)
// The whole card is one link; the image is decorative (alt="") because the title says what it shows.
import { url } from '../../lib/url';
import Icon from '../Icon.astro';
import { count as countOf } from '../../lib/plural';
import { filters, nbsp, small, smallSizeOf, workMonth, type Realizacja } from '../../data/realizacje';

interface Props {
  r: Realizacja;
  wide?: boolean;
  heading?: 'h2' | 'h3';
}
const { r, wide = false, heading: Heading = 'h3' } = Astro.props;
const c = r.cover;
const s = smallSizeOf(c);
const place = r.town ? `${r.town} · ${r.buildingType.toLowerCase()}` : r.buildingType;
const tags = filters.filter((f) => r.filters.includes(f.key)).map((f) => f.label);
const count = r.photos.length;
const hasPair = r.photos.some((ph) => ph.pair);
---

<article class:list={['pcard', { 'pcard--wide': wide }]}>
  <a class="pcard__link" href={url(`/realizacje/${r.slug}/`)}>
    <div class="pcard__media photo">
      <img
        src={url(small(c.src))}
        srcset={`${url(small(c.src))} ${s.width}w, ${url(c.src)} ${c.width}w`}
        sizes={wide ? '(min-width: 960px) 60vw, 100vw' : '(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw'}
        alt=""
        width={s.width}
        height={s.height}
        loading="lazy"
        decoding="async"
        style={c.position ? `object-position:${c.position}` : undefined}
      />
      <span class="pcard__count">{countOf(count, 'zdjęcie', 'zdjęcia', 'zdjęć')}{hasPair ? ' · przed i po' : ''}</span>
    </div>
    <div class="pcard__body">
      <p class="pcard__meta">
        <span>{place}</span>
        <span aria-hidden="true">·</span>
        <span>{workMonth(r)}</span>
      </p>
      <Heading class="pcard__title">{nbsp(r.cardTitle)}</Heading>
      <ul class="pcard__tags" aria-label="Produkty">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
      <span class="pcard__more">Zobacz realizację <Icon name="arrow" class="" /></span>
    </div>
  </a>
</article>

<style>
  .pcard { height: 100%; }
  .pcard__link {
    display: flex; flex-direction: column;
    height: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    transition: border-color .25s, box-shadow .35s var(--ease);
  }
  .pcard__link:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .pcard__media { aspect-ratio: 4 / 3; }
  .pcard__media img { width: 100%; height: 100%; object-fit: cover; }
  .pcard__link:hover .pcard__media img { transform: scale(1.03); }
  .pcard__count {
    position: absolute; left: 12px; bottom: 12px;
    padding: 4px 10px;
    font-size: .74rem; font-weight: 600;
    color: var(--ink);
    background: var(--bg);
    border-radius: 999px;
  }
  .pcard__body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 22px 24px 24px; }
  .pcard__meta { display: flex; flex-wrap: wrap; gap: 4px 8px; margin: 0; font-size: .8rem; color: var(--muted); }
  .pcard__meta span { white-space: nowrap; }
  .pcard__title { font-size: 1.12rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.015em; }
  .pcard__tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 0; padding: 0; list-style: none; }
  .pcard__tags li {
    padding: 3px 10px;
    font-size: .74rem; font-weight: 500;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .pcard__more {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: auto; padding-top: 10px;
    font-size: .86rem; font-weight: 600; color: var(--ink);
  }
  .pcard__more :global(svg) { width: 15px; height: 15px; transition: transform .25s var(--ease); }
  .pcard__link:hover .pcard__more { color: var(--navy); }
  .pcard__link:hover .pcard__more :global(svg) { transform: translateX(4px); }
  .pcard__link:focus-visible { outline-offset: 4px; }

  /* wide: image left, text right on desktop */
  @media (min-width: 960px) {
    .pcard--wide .pcard__link { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .pcard--wide .pcard__media { aspect-ratio: 3 / 2; }
    .pcard--wide .pcard__body { padding: clamp(28px, 3vw, 44px); justify-content: center; }
    .pcard--wide .pcard__title { font-size: clamp(1.4rem, 2vw, 1.8rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; }
    .pcard--wide .pcard__more { margin-top: 18px; }
  }
</style>
