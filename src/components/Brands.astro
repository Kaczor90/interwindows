---
// Producers strip: DAKO (authorised partner) highlighted + supplier logos + names without logos.
//   <Brands />   ·   <Brands title="Marki, z którymi pracujemy" />
import { url } from '../lib/url';
import { dako, brandLogos, brandNames } from '../data/partners';

interface Props {
  eyebrow?: string;
  title?: string;
}
const { eyebrow = 'Partnerzy', title = 'Sprawdzeni producenci, z którymi pracujemy' } = Astro.props;
---

<section class="section section--tight" id="partnerzy">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
      </div>
      <p class="muted">Dobieramy producenta do budynku i oczekiwań, a nie odwrotnie. Montaż w każdym przypadku wykonuje nasza ekipa.</p>
    </div>
    <div class="brands">
      <div class="brand-feature on-dark reveal">
        <div class="brand-feature__logo"><img src={url(dako.logo!)} alt="DAKO" width="240" height="72" loading="lazy" /></div>
        <div>
          <span class="eyebrow">Autoryzowany partner</span>
          <strong>Autoryzowany partner DAKO</strong>
          <p>W ofercie DAKO mamy {dako.scope}. Okna PCV to system DAKO DPQ-82 na profilu VEKA Softline 82 MD.</p>
        </div>
      </div>
      <div class="brand-grid reveal">
        {brandLogos.map((b) => (
          <div class="brand-cell" title={`${b.name} – ${b.scope}`}><img src={url(b.logo!)} alt={b.name} loading="lazy" /></div>
        ))}
        <p class="brand-names"><b>Także:</b>{brandNames.map((n) => <span>{n}</span>)}</p>
      </div>
    </div>
  </div>
</section>
